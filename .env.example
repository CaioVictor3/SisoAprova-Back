# Origem da interface (CORS, OAuth e links de e-mail).
FRONTEND_APPLICATION_URL=http://localhost:5173
# Use 0 em desenvolvimento local direto e 1 (ou hops reais do proxy) em produção no Render.
BACKEND_TRUSTED_PROXY_HOP_COUNT=0

# Supabase.
SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_API_KEY=
SUPABASE_SERVER_SECRET_API_KEY=

# OpenAI (análise de questões).
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4.1-mini

# Mercado Pago (Checkout Bricks + Payments API).
# Webhook: /api/financeiro/webhook | Cron: POST /api/financeiro/tarefas
MERCADO_PAGO_ENVIRONMENT=teste
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SIGNING_SECRET=
MERCADO_PAGO_SELLER_ACCOUNT_ID=
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_MAX_INSTALLMENTS=1
MERCADO_PAGO_PRODUCTION_ENABLED=false
MERCADO_PAGO_MAINTENANCE_AUTHORIZATION_SECRET=
MERCADO_PAGO_FINANCIAL_OPERATIONS_ENABLED=false
MERCADO_PAGO_PRODUCTION_OPERATIONS_AUTHORIZED=false

# Resend (servidor/worker de e-mails transacionais).
# Webhook: /api/ResendWebhook/registrar-evento-entrega | Cron: POST /api/comunicacao/tarefas
RESEND_API_KEY=
RESEND_SENDER_EMAIL_ADDRESS=
RESEND_SENDER_DISPLAY_NAME=Siso Aprova
RESEND_WEBHOOK_SIGNING_SECRET=
TRANSACTIONAL_EMAIL_WORKER_ENABLED=false
TRANSACTIONAL_EMAIL_MAINTENANCE_AUTHORIZATION_SECRET=
